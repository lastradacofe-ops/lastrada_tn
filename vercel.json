{
  "buildCommand": "pnpm --filter ./client run build",
  "outputDirectory": "client/dist/public",
  "protection": {
    "deploymentType": "none"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://lastrada-tn.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

